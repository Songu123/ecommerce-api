    },
    {
      "name": "14. Get Statistics with Date Range (Admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
    "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/statistics?fromDate=2024-01-01&toDate=2024-12-31",
 "host": ["{{baseUrl}}"],
    "path": ["api", "orders", "statistics"],
          "query": [
   {
          "key": "fromDate",
         "value": "2024-01-01"
  },
        {
        "key": "toDate",
  "value": "2024-12-31"
  }
  ]
        }
      }
