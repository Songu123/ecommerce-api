          "mode": "raw",
          "raw": "{\n  \"shippingAddress\": \"123 Nguy?n Hu?, Qu?n 1, TP. H? Chí Minh\",\n  \"shippingNote\": \"G?i tr??c khi giao\",\n  \"paymentMethod\": \"COD - Thanh toán khi nh?n hàng\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 1\n    },\n    {\n      \"productId\": 5,\n      \"quantity\": 2\n    }\n  ]\n}"
},
        "url": {
